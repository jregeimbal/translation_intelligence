{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run/Debug Tests",
            "request": "launch",
            "type": "dart",
            "templateFor": "",
            "toolArgs": [
                "test/"
            ],
            "noDebug": true
        },
        {
            "name": "Server (debug)",
            "type": "dart",
            "request": "launch",
            "program": "server/bin/server.dart",
            "env": {
                "FIREBASE_PROJECT_ID": "tutti-lingo",
                "GOOGLE_SERVICE_ACCOUNT_JSON_PATH": "omnia-lingo-google-cloud-service-account.json",
                "ALLOWED_ORIGINS": "http://localhost:3000",
                "SERVER_HOST": "0.0.0.0",
                "PORT": "8080"
            },
            "vmAdditionalArgs": ["--observe"]
        },
        {
            "name": "App (debug)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "args": [
                "--web-hostname=localhost",
                "--web-port=3000",
                "--dart-define", "API_BASE_URL=http://jons-macbook-pro:8080"
            ],
        },
        {
            "name": "App (profile)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "args": [
                "--web-hostname=0.0.0.0",
                "--web-port=3000",
                "--dart-define", "API_BASE_URL=http://localhost:8080"
            ],
        },
        {
            "name": "App (release w/ local server)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--web-hostname=localhost",
                "--web-port=3000",
                "--dart-define", "API_BASE_URL=http://localhost:8080"
            ],
        },
        {
            "name": "App (release)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--web-hostname=localhost",
                "--web-port=3000",
                "--dart-define", "NO_DOTENV_OVERRIDE=true",
                "--dart-define", "API_BASE_URL=https://omnialingo-server-633223066396.us-central1.run.app/"
            ],
        }
    ],
    "compounds": [
    {
      "name": "Server & App (debug)",
      "configurations": ["Server (debug)", "App (debug)"],
      "stopAll": true
    }
  ]
}