{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter test (coverage)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/test_with_coverage.dart"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "flutter build appbundle (release)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=google-play-service-account.json tool/upload_play_release.dart"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "server release",
      "type": "shell",
      "command": "GCP_PROJECT_ID=project-d3d4e8f9-a909-4391-a0e CLOUD_RUN_REGION=us-central1 ARTIFACT_REPOSITORY=omnialingo ALLOWED_ORIGINS=https://omnialingo.jax3.com,http://localhost:3000 FIREBASE_PROJECT_ID=tutti-lingo tool/deploy_server_cloud_run.sh",
      "group": "build"
    },
    {
      "label": "flutter deploy web (gcs)",
      "type": "shell",
      "command": "WEB_BUCKET=omnialingo.jax3.com WEB_URL=https://omnialingo.jax3.com API_BASE_URL=https://omnialingo-server-633223066396.us-central1.run.app/ tool/deploy_web_gcs.sh",
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": []
    }
  ]
}
