{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter test (coverage)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/test_with_coverage.dart"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "flutter build appbundle (release)",
      "type": "shell",
      "command": "flutter build appbundle --release --dart-define=\"NO_DOTENV_OVERRIDE=true\" --dart-define=\"API_BASE_URL=https://translation-intelligence-server-807627897911.us-central1.run.app\"",
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "server release",
      "type": "shell",
      "command": "GCP_PROJECT_ID=tutti-lingo CLOUD_RUN_REGION=us-central1 ARTIFACT_REPOSITORY=translation-intelligence ALLOWED_ORIGINS=https://omnialingo.jax3.com,http://localhost:3000 FIREBASE_PROJECT_ID=tutti-lingo tool/deploy_server_cloud_run.sh",
      "group": "build",
    }
  ]
}
