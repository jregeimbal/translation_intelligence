#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# --- Secret scanning with gitleaks ---
if [ "${SKIP_GITLEAKS:-0}" != "1" ] && command -v gitleaks >/dev/null 2>&1; then
  STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)
  NEEDS_SCAN=0
  for f in $STAGED_FILES; do
    case "$f" in
      *.json|*.yml|*.yaml|*.toml|*.env*|*.dart|*.sh|*.md|*.toml)
        NEEDS_SCAN=1
        break
        ;;
    esac
  done

  if [ "$NEEDS_SCAN" = "1" ]; then
    echo "Running gitleaks secret scan..."
    if ! gitleaks detect --source . --config .gitleaks.toml --verbose; then
      echo ""
      echo "ERROR: Potential secret detected in staged files."
      echo "Fix the secret or skip this check with:"
      echo "  SKIP_GITLEAKS=1 git commit"
      exit 1
    fi
    echo "Gitleaks scan passed."
  fi
fi

# --- Bump pubspec build number ---
if [ "${SKIP_PUBSPEC_BUILD_BUMP:-0}" = "1" ]; then
  exit 0
fi

if [ ! -f pubspec.yaml ]; then
  exit 0
fi

dart run tool/bump_build_number.dart
git add pubspec.yaml